<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pinned project revisions. Named with a "zz-" prefix so it loads
  alphabetically last in .repo/local_manifests/, after andycgyan-unified.xml
  and upstream-treble.xml — letting these <project> entries override the
  revisions those files declared.

  Pin tiers:
    1. Archival (AndyCGYan repos): branch lineage-20-light is effectively
       dead since Nov 2023, so these SHAs are HEAD and won't drift. Pinned
       for explicitness and to insulate from any surprise resurrection.
    2. Frozen (TrebleDroid/vendor_hardware_overlay): upstream is still
       active, but every commit since this SHA is device overlays we don't
       use. Freezing keeps AndyCGYan's bridge patches applicable without
       maintenance. Advance only if you need a newer device overlay.

  LineageOS-side projects (frameworks/base, system/core, …) are intentionally
  NOT pinned — they receive monthly security updates, and AndyCGYan's bridge
  patches generally survive LineageOS churn via apply_patches.sh's fuzz
  fallback. Add a pin here only if a specific project's patches start failing.

  Updating: bump the revision="..." attribute below, then re-run ./build.sh.
  The pin drift check in 00-prep-source.sh shows current upstream HEAD vs the
  pinned SHA on every sync run.
-->
<manifest>
  <!-- archival: AndyCGYan/lineage_patches_unified HEAD on lineage-20-light, Nov 19 2023 -->
  <project path="lineage_patches_unified" name="lineage_patches_unified"
           remote="andycgyan" revision="1865fc784bc72a2d82fb938f18edb66af90ba306" />

  <!-- archival: AndyCGYan/lineage_build_unified HEAD on lineage-20-light, Nov 2023 -->
  <project path="lineage_build_unified" name="lineage_build_unified"
           remote="andycgyan" revision="ba21a0d381b988cef51387896a603cc2871045b8" />

  <!-- frozen: TrebleDroid/vendor_hardware_overlay at 1bbceba (Nov 17 2023) -
       chosen as the last commit before changes that would break AndyCGYan's
       0001-Exclude-TrebleApp-co.patch trailing context. -->
  <project path="vendor/hardware_overlay" name="TrebleDroid/vendor_hardware_overlay"
           remote="github" revision="1bbceba47362299ae60cb96c08303fb5f930e853" />
</manifest>
